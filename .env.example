# CricketOS — copy to .env.local. Never commit real secrets.

# Data provider: demo (default) | cricapi | sportmonks
CRICKETOS_DATA_PROVIDER=demo
# CRICKETOS_DATA_API_KEY=

# Optional LLM explain layer (must not invent numbers)
CRICKETOS_LLM_PROVIDER=off
# CRICKETOS_LLM_API_KEY=
# CRICKETOS_LLM_MODEL=
