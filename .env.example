# CricketOS — copy to .env.local. Never commit real secrets.
# Secrets are server-only — do NOT prefix API keys with NEXT_PUBLIC_.

# --- Live scores (one-click) ---
# 1) Sign up at https://cricketdata.org/ and copy your API key
# 2) Set provider + key below, restart next dev
# 3) Confirm GET /api/health → demoMode: false
# Vercel: Project → Settings → Environment Variables → same keys → Redeploy

# Data provider: demo (default) | cricapi | sportmonks
CRICKETOS_DATA_PROVIDER=demo
# CRICKETOS_DATA_API_KEY=
# Optional override base URL (tests / proxy) — do not put secrets in the URL
# CRICKETOS_DATA_API_BASE_URL=

# Freshness: LIVE becomes STALE after this many ms without update (default 120000)
# CRICKETOS_STALE_AFTER_MS=120000
# CRICKETOS_PROVIDER_TIMEOUT_MS=12000
# CRICKETOS_PROVIDER_MAX_RETRIES=2

# Storage: memory (default, ephemeral) | postgres (requires DATABASE_URL + migrations)
CRICKETOS_STORAGE_BACKEND=memory
# DATABASE_URL=

# Required to enable POST /api/ingestion/run (refused when unset)
# CRICKETOS_INGESTION_TOKEN=

# Optional LLM explain layer (must not invent numbers)
CRICKETOS_LLM_PROVIDER=off
# CRICKETOS_LLM_API_KEY=
# CRICKETOS_LLM_MODEL=
